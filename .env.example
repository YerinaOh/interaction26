# 실제 Claude 답변을 받으려면 .env.local 에 키를 넣으세요. 비워 두면 가짜(mock) 답변을 씁니다.
ANTHROPIC_API_KEY=

# live | mock — 키가 있어도 mock으로 고정하고 싶을 때 지정
GENERATION_MODE=

# 참가자 응답 저장소 (Vercel Blob, private). Vercel 대시보드에서 스토어를 프로젝트에 연결하면 자동으로 들어간다.
# 로컬에서 테스트·내보내기를 하려면 `vercel env pull .env.local` 로 받거나 토큰을 직접 넣는다.
BLOB_READ_WRITE_TOKEN=

# 학번·이름 암호화 키 (아무 긴 비밀 문자열). 비워 두면 학번·이름은 저장하지 않는다.
# 한 번 정하면 바꾸지 말 것 — 바꾸면 이전 데이터를 복호화할 수 없다.
PARTICIPANT_KEY=
